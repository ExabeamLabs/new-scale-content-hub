{"title":"Java4Shell - Java Execution and JVM Artifacts","description":"Focused companion to the Exabeam CVE-2026-114938 (Java4Shell) customer advisory: JVM crash-artifact observations and Java processes starting a shell, scripting, download or recon tool. Investigation leads, not confirmed compromise.","useCases":[],"mitreInfo":[],"dashboardElements":[{"title_text":"Java4Shell: Java execution and JVM artifacts","subtitle_text":"","body_text":"Review JVM crash-artifact observations and the tools Java started on each host. Results are investigation leads, not confirmed compromise. Counts overlap; do not sum. Set the date filter to since disclosure (17 Nov 2026), then widen it.","title_hidden":false,"type":"text","height":2,"width":24,"row":0,"column":0},{"title":"JVM artifact observations","title_hidden":false,"type":"vis","view":"event","fields":["event.count"],"pivots":null,"filters":{"event.approx_log_time":"30 day"},"filter_expression":"(yes)\n#EXPRESSION-START#{\"combinator\":\"and\",\"rules\":[{\"field\":{\"name\":\"event.activity_type\",\"label_short\":\"Activity Type\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"file-write,file-create,file-modify\"},{\"field\":{\"name\":\"event.file_name\",\"label_short\":\"File Name\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"hs_err_pid%\"}],\"nextFilter\":{}}#EXPRESSION-END#","sorts":[],"limit":"50","vis_config":{"type":"single_value"},"dynamic_fields":"[]","model":"datalake","result_maker":{"filterables":[{"model":"datalake","view":"event","name":"","listen":[{"dashboard_filter_name":"Event : Approx Log Date","field":"event.approx_log_date"}]}]},"height":2,"width":12,"row":2,"column":0},{"title":"Java shell / tool observations","title_hidden":false,"type":"vis","view":"event","fields":["event.count"],"pivots":null,"filters":{"event.approx_log_time":"30 day"},"filter_expression":"(yes)\n#EXPRESSION-START#{\"combinator\":\"and\",\"rules\":[{\"field\":{\"name\":\"event.activity_type\",\"label_short\":\"Activity Type\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"process-create\"},{\"field\":{\"name\":\"event.parent_process_path\",\"label_short\":\"Parent Process Path\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"%/java,%\\\\java.exe,%\\\\javaw.exe,%\\\\tomcat%.exe\"},{\"field\":{\"name\":\"event.process_path\",\"label_short\":\"Process Path\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"%/sh,%/bash,%/dash,%/busybox,%/pwsh,%/python,%/python2,%/python3,%/python3.%,%/perl,%/curl,%/wget,%/nc,%/ncat,%/netcat,%/nc.openbsd,%/nc.traditional,%/whoami,%/nslookup,%/dig,%\\\\cmd.exe,%\\\\powershell.exe,%\\\\pwsh.exe,%\\\\cscript.exe,%\\\\wscript.exe,%\\\\curl.exe,%\\\\certutil.exe,%\\\\whoami.exe,%\\\\net.exe,%\\\\nslookup.exe\"}],\"nextFilter\":{}}#EXPRESSION-END#","sorts":[],"limit":"50","vis_config":{"type":"single_value"},"dynamic_fields":"[]","model":"datalake","result_maker":{"filterables":[{"model":"datalake","view":"event","name":"","listen":[{"dashboard_filter_name":"Event : Approx Log Date","field":"event.approx_log_date"}]}]},"height":2,"width":12,"row":2,"column":12},{"title_text":"1. JVM crash artifacts","subtitle_text":"","body_text":"hs_err_pid* files written, created or modified. Counts are matching events, not distinct crashes.","title_hidden":false,"type":"text","height":2,"width":24,"row":4,"column":0},{"title":"Hosts by crash-artifact observations","title_hidden":false,"type":"vis","view":"event","fields":["event.host","event.count"],"pivots":null,"filters":{"event.approx_log_time":"30 day"},"filter_expression":"(yes)\n#EXPRESSION-START#{\"combinator\":\"and\",\"rules\":[{\"field\":{\"name\":\"event.activity_type\",\"label_short\":\"Activity Type\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"file-write,file-create,file-modify\"},{\"field\":{\"name\":\"event.file_name\",\"label_short\":\"File Name\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"hs_err_pid%\"}],\"nextFilter\":{}}#EXPRESSION-END#","sorts":[],"limit":"25","vis_config":{"type":"looker_bar"},"dynamic_fields":"[]","model":"datalake","result_maker":{"filterables":[{"model":"datalake","view":"event","name":"","listen":[{"dashboard_filter_name":"Event : Approx Log Date","field":"event.approx_log_date"}]}]},"height":6,"width":12,"row":6,"column":0},{"title":"Crash-artifact observations per day, by host","title_hidden":false,"type":"vis","view":"event","fields":["event.approx_log_date","event.host","event.count"],"pivots":["event.host"],"filters":{"event.approx_log_time":"30 day"},"filter_expression":"(yes)\n#EXPRESSION-START#{\"combinator\":\"and\",\"rules\":[{\"field\":{\"name\":\"event.activity_type\",\"label_short\":\"Activity Type\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"file-write,file-create,file-modify\"},{\"field\":{\"name\":\"event.file_name\",\"label_short\":\"File Name\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"hs_err_pid%\"}],\"nextFilter\":{}}#EXPRESSION-END#","sorts":[],"limit":"500","vis_config":{"type":"looker_line"},"dynamic_fields":"[]","model":"datalake","result_maker":{"filterables":[{"model":"datalake","view":"event","name":"","listen":[{"dashboard_filter_name":"Event : Approx Log Date","field":"event.approx_log_date"}]}]},"height":6,"width":12,"row":6,"column":12},{"title":"Crash-artifact files by host","title_hidden":false,"type":"vis","view":"event","fields":["event.host","event.user","event.process_name","event.file_path","event.file_name","event.count"],"pivots":null,"filters":{"event.approx_log_time":"30 day"},"filter_expression":"(yes)\n#EXPRESSION-START#{\"combinator\":\"and\",\"rules\":[{\"field\":{\"name\":\"event.activity_type\",\"label_short\":\"Activity Type\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"file-write,file-create,file-modify\"},{\"field\":{\"name\":\"event.file_name\",\"label_short\":\"File Name\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"hs_err_pid%\"},{\"field\":{\"name\":\"event.host\",\"label_short\":\"Host\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"-NULL,-N/A\"}],\"nextFilter\":{}}#EXPRESSION-END#","sorts":[],"limit":"500","vis_config":{"type":"table"},"dynamic_fields":"[]","model":"datalake","result_maker":{"filterables":[{"model":"datalake","view":"event","name":"","listen":[{"dashboard_filter_name":"Event : Approx Log Date","field":"event.approx_log_date"}]}]},"height":7,"width":24,"row":12,"column":0},{"title_text":"2. Java starting a shell, scripting, download or recon tool","subtitle_text":"","body_text":"Tools monitored when started by a Java process (Linux names, then Windows):\n  Shells: sh, bash, dash, busybox, pwsh, cmd.exe, powershell.exe, pwsh.exe\n  Scripting: python, python2, python3, python3.x, perl, cscript.exe, wscript.exe\n  Download: curl, wget, curl.exe, certutil.exe\n  Network and recon: nc, ncat, netcat, nc.openbsd, nc.traditional, whoami, nslookup, dig, whoami.exe, net.exe, nslookup.exe\nLow counts in the selected window are not the same as rare against a baseline: widen the date filter to compare, and check scheduled agents before escalating.","title_hidden":false,"type":"text","height":2,"width":24,"row":19,"column":0},{"title":"Hosts where Java started a listed tool","title_hidden":false,"type":"vis","view":"event","fields":["event.host","event.count"],"pivots":null,"filters":{"event.approx_log_time":"30 day"},"filter_expression":"(yes)\n#EXPRESSION-START#{\"combinator\":\"and\",\"rules\":[{\"field\":{\"name\":\"event.activity_type\",\"label_short\":\"Activity Type\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"process-create\"},{\"field\":{\"name\":\"event.parent_process_path\",\"label_short\":\"Parent Process Path\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"%/java,%\\\\java.exe,%\\\\javaw.exe,%\\\\tomcat%.exe\"},{\"field\":{\"name\":\"event.process_path\",\"label_short\":\"Process Path\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"%/sh,%/bash,%/dash,%/busybox,%/pwsh,%/python,%/python2,%/python3,%/python3.%,%/perl,%/curl,%/wget,%/nc,%/ncat,%/netcat,%/nc.openbsd,%/nc.traditional,%/whoami,%/nslookup,%/dig,%\\\\cmd.exe,%\\\\powershell.exe,%\\\\pwsh.exe,%\\\\cscript.exe,%\\\\wscript.exe,%\\\\curl.exe,%\\\\certutil.exe,%\\\\whoami.exe,%\\\\net.exe,%\\\\nslookup.exe\"}],\"nextFilter\":{}}#EXPRESSION-END#","sorts":[],"limit":"25","vis_config":{"type":"looker_bar"},"dynamic_fields":"[]","model":"datalake","result_maker":{"filterables":[{"model":"datalake","view":"event","name":"","listen":[{"dashboard_filter_name":"Event : Approx Log Date","field":"event.approx_log_date"}]}]},"height":7,"width":10,"row":21,"column":0},{"title":"Java parent -> child pairs","title_hidden":false,"type":"vis","view":"event","fields":["event.host","event.parent_process_path","event.process_path","event.count"],"pivots":null,"filters":{"event.approx_log_time":"30 day"},"filter_expression":"(yes)\n#EXPRESSION-START#{\"combinator\":\"and\",\"rules\":[{\"field\":{\"name\":\"event.activity_type\",\"label_short\":\"Activity Type\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"process-create\"},{\"field\":{\"name\":\"event.parent_process_path\",\"label_short\":\"Parent Process Path\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"%/java,%\\\\java.exe,%\\\\javaw.exe,%\\\\tomcat%.exe\"},{\"field\":{\"name\":\"event.process_path\",\"label_short\":\"Process Path\",\"view\":\"event\",\"type\":\"string\"},\"expression\":\"%/sh,%/bash,%/dash,%/busybox,%/pwsh,%/python,%/python2,%/python3,%/python3.%,%/perl,%/curl,%/wget,%/nc,%/ncat,%/netcat,%/nc.openbsd,%/nc.traditional,%/whoami,%/nslookup,%/dig,%\\\\cmd.exe,%\\\\powershell.exe,%\\\\pwsh.exe,%\\\\cscript.exe,%\\\\wscript.exe,%\\\\curl.exe,%\\\\certutil.exe,%\\\\whoami.exe,%\\\\net.exe,%\\\\nslookup.exe\"}],\"nextFilter\":{}}#EXPRESSION-END#","sorts":[],"limit":"100","vis_config":{"type":"table"},"dynamic_fields":"[]","model":"datalake","result_maker":{"filterables":[{"model":"datalake","view":"eve