###################### Simple Firewall Log Searches ######################

# FTP, Telnet and SCP to External Destinations
dest_port: (20,21,22,23) AND NOT dest_ip: [10.0.0.0/8] AND NOT dest_ip: [172.16.0.0/12] AND NOT dest_ip: [192.168.0.0/16] AND NOT dest_ip: NULL 

# Database attempts to External Destinations
dest_port: (1433, 3306, 5432, 1521, 6379, 9042) AND NOT dest_ip: [10.0.0.0/8] AND NOT dest_ip: [172.16.0.0/12] AND NOT dest_ip: [192.168.0.0/16] AND NOT dest_ip: NULL

# Remote Desktop attempts to External Destinations
dest_port: 3389 AND NOT dest_ip: [10.0.0.0/8] AND NOT dest_ip: [172.16.0.0/12] AND NOT dest_ip: [192.168.0.0/16] AND NOT dest_ip: NULL 

# Remote Desktop attempts to Non-United States External Destinations
dest_port: 3389 AND NOT geo_dest_ip.country: "us" AND NOT dest_ip: [10.0.0.0/8] AND NOT dest_ip: [172.16.0.0/12] AND NOT dest_ip: [192.168.0.0/16] AND NOT dest_ip: NULL 

