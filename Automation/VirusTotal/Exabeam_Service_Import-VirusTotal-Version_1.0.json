{
  "openapi": "3.0.0",
  "info": {
    "title": "VirusTotal IP Address API",
    "description": "API specification for retrieving IP address information from VirusTotal",
    "version": "3.0"
  },
  "servers": [
    {
      "url": "https://www.virustotal.com/api/v3",
      "description": "VirusTotal API v3 Production Server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/ip_addresses/{ip}": {
      "get": {
        "operationId": "getIpAddressInfo",
        "summary": "Get information about an IP address",
        "description": "Retrieves analysis and reputation details for a given IP address from VirusTotal",
        "parameters": [
          {
            "name": "ip",
            "in": "path",
            "required": true,
            "description": "The IP address to retrieve information for",
            "schema": {
              "type": "string",
              "example": "8.8.8.8"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with IP address details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "IP address identifier"
                        },
                        "type": {
                          "type": "string",
                          "description": "Resource type (ip_address)"
                        },
                        "attributes": {
                          "type": "object",
                          "properties": {
                            "as_owner": {
                              "type": "string",
                              "description": "Autonomous system owner"
                            },
                            "asn": {
                              "type": "integer",
                              "description": "Autonomous system number"
                            },
                            "country": {
                              "type": "string",
                              "description": "Country code"
                            },
                            "continent": {
                              "type": "string",
                              "description": "Continent code"
                            },
                            "last_analysis_stats": {
                              "type": "object",
                              "description": "Summary of analysis results",
                              "properties": {
                                "harmless": {
                                  "type": "integer",
                                  "description": "Number of engines that found the IP harmless"
                                },
                                "malicious": {
                                  "type": "integer",
                                  "description": "Number of engines that found the IP malicious"
                                },
                                "suspicious": {
                                  "type": "integer",
                                  "description": "Number of engines that found the IP suspicious"
                                },
                                "undetected": {
                                  "type": "integer",
                                  "description": "Number of engines that did not detect anything"
                                },
                                "timeout": {
                                  "type": "integer",
                                  "description": "Number of engines that timed out"
                                }
                              }
                            },
                            "reputation": {
                              "type": "integer",
                              "description": "Reputation score"
                            },
                            "network": {
                              "type": "string",
                              "description": "Network range"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid IP or missing parameters)"
          },
          "401": {
            "description": "Unauthorized (invalid API key)"
          },
          "404": {
            "description": "IP address not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-apikey",
        "description": "Your VirusTotal API key"
      }
    }
  }
}
