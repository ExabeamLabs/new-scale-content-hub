{
	"version": "1",
	"ruleDefinitions": [
		{
			"name": "Exabeam: Flatline rule to monitor Microsoft Windows data source",
			"description": "Alerts if less than 10 events from vendor in 4 hours",
			"useCase": "",
			"mitre": [],
			"sequencesExecution": "CREATION_ORDER",
			"severity": "none",
			"sequencesConfig": {
				"sequences": [
					{
						"name": "Windows Events",
						"query": "vendor:\"Microsoft\" AND platform:\"Windows\"",
						"condition": {
							"groupByOption": false,
							"groupBy": [],
							"functionType": "count",
							"subject": "field",
							"field": "activity_type",
							"operator": "less_than",
							"value": "10",
							"time": 4,
							"unit": "h",
							"triggerOnAnyMatch": false
						},
						"id": "7882e86e-2223-4419-929e-ead3f1afbf23"
					}
				],
				"commonProperties": null,
				"outcomes": null
			}
		}
	]
}
