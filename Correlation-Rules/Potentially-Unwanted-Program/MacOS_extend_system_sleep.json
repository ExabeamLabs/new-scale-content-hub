{
    "version": "1",
    "ruleDefinitions": [
        {
            "name": "MacOS users extending system sleep defaults",
            "description": "MacOS users extending system sleep defaults possibly leaving workstations open more than intended",
            "useCase": "evasion",
            "mitre": [
                {
                    "tacticKey": "TA0005",
                    "tactic": "Stealth",
                    "techniqueKey": "T1564",
                    "technique": "Hide Artifacts"
                }
            ],
            "sequencesExecution": "CREATION_ORDER",
            "severity": "medium",
            "sequencesConfig": {
                "sequences": [
                    {
                        "name": "Caffeinate process detected",
                        "query": "activity_type:\"process-create\" AND process_name:RGXi(\"caffeinate\") AND NOT process_command_line:RGXi(\"caffeinate -i -t 300\")",
                        "condition": {
                            "groupByOption": true,
                            "groupBy": [
                                "dest_device_entity_id"
                            ],
                            "triggerOnAnyMatch": true
                        },
                        "id": "4f979e80-a4c0-4a46-baba-9f15f1c634b9"
                    }
                ],
                "commonProperties": null,
                "restrictToSite": null,
                "outcomes": null
            },
            "scheduleConfig": null
        }
    ]
}
