{
    "version": "1",
    "ruleDefinitions": [
        {
            "name": "Homebrew Threat Command Execution",
            "description": "Alerts when process name matches in the 'Threat Homebrew Commands' context table, indicating potential malicious activity.",
            "useCase": "malware",
            "mitre": [
                {
                    "tacticKey": "TA0002",
                    "tactic": "Execution",
                    "techniqueKey": "T1059",
                    "technique": "Command and Scripting Interpreter"
                }
            ],
            "sequencesExecution": "CREATION_ORDER",
            "severity": "high",
            "sequencesConfig": {
                "sequences": [
                    {
                        "name": "Homebrew threat command execution",
                        "query": "process_name IN \"Homebrew Threat Commands\".\"Key\" AND process_command_line: \"homebrew\"",
                        "condition": {
                            "groupByOption": true,
                            "groupBy": [
                                "src_host"
                            ],
                            "triggerOnAnyMatch": true
                        },
                        "id": "20041007-6aa2-4ec3-bfcb-76e5d684b1cb"
                    }
                ],
                "commonProperties": null,
                "restrictToSite": null,
                "outcomes": null
            },
            "scheduleConfig": null
        }
    ]
}
