{
	"version": "1",
	"ruleDefinitions": [
		{
			"name": "Exabeam: Flatline rule to monitor Zscaler data source",
			"description": "Alerts if less than 10 events from vendor in 4 hours",
			"useCase": "",
			"mitre": [],
			"sequencesExecution": "CREATION_ORDER",
			"severity": "none",
			"sequencesConfig": {
				"sequences": [
					{
						"name": "Zscaler Events",
						"query": "vendor: \"Zscaler\"",
						"condition": {
							"groupByOption": false,
							"groupBy": [],
							"functionType": "count",
							"subject": "field",
							"field": "activity_type",
							"operator": "less_than",
							"value": "10",
							"time": 4,
							"unit": "h",
							"triggerOnAnyMatch": false
						},
						"id": "4b4a07b1-0e02-4bc2-9498-e20bac3f9b0a"
					}
				],
				"commonProperties": null,
				"outcomes": null
			}
		}
	]
}
