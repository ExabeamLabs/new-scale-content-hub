{
    "version": "1",
    "ruleDefinitions": [
        {
            "name": "Network Connectivity Linux",
            "description": "This rule detects attempts to check network connectivity using 'netstat' or 'ss' commands. This could indicate an attacker trying to map the network.",
            "useCase": "evasion",
            "mitre": [
                {
                    "tacticKey": "TA0007",
                    "tactic": "Discovery",
                    "techniqueKey": "T1049",
                    "technique": "System Network Connections Discovery"
                }
            ],
            "sequencesExecution": "CREATION_ORDER",
            "severity": "none",
            "sequencesConfig": {
                "sequences": [
                    {
                        "name": "",
                        "query": "vendor: \"Unix\" AND (process_command_line:\"netstat\" OR process_name:\"ss\")\n",
                        "condition": {
                            "triggerOnAnyMatch": true
                        },
                        "id": "0b4a355e-0a5e-4c4a-935e-b13f0d65df30"
                    }
                ],
                "commonProperties": null,
                "outcomes": null
            },
            "scheduleConfig": null
        }
    ]
}