{
    "version": "1",
    "ruleDefinitions": [
        {
            "name": "Linux: Changes to critical directories",
            "description": "Linux: Changes to critical directories",
            "useCase": "privileged_activity",
            "mitre": [
                {
                    "tacticKey": "TA0004",
                    "tactic": "Privilege Escalation",
                    "techniqueKey": "T1068",
                    "technique": "Exploitation for Privilege Escalation"
                }
            ],
            "sequencesExecution": "CREATION_ORDER",
            "severity": "low",
            "sequencesConfig": {
                "sequences": [
                    {
                        "name": "",
                        "query": "(\"/boot\" OR \"/etc\" OR \"/var/www\" OR \"/bin\" OR \"/sbin\" OR \"/usr/bin\" OR \"/usr/sbin\" OR \"/lib\" OR \"/lib64\")AND ( vendor: \"Unix\" ) AND (\"WRITE\" OR  \"CREATE\" OR \"DELETE\" OR \"RENAME\" OR \"CHMOD\" OR \"CHOWN\") AND NOT \"/etc/fstab\"  AND NOT user: \"root\"",
                        "condition": {
                            "groupByOption": true,
                            "groupBy": [
                                "host",
                                "user"
                            ],
                            "functionType": "count",
                            "subject": "event",
                            "field": "",
                            "operator": "more_than",
                            "value": "0",
                            "time": 10,
                            "unit": "m",
                            "triggerOnAnyMatch": false
                        },
                        "id": "4aafee13-cc31-4137-adbb-4838f93e5645"
                    }
                ],
                "commonProperties": null,
                "outcomes": null
            },
            "scheduleConfig": null
        }
    ]
