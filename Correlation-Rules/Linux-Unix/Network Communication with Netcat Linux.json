{
    "version": "1",
    "ruleDefinitions": [
        {
            "name": "Network Communication with Netcat Linux",
            "description": "This rule detects attempts to establish network communication with the 'netcat' command. This could be indicative of an attacker trying to establish command and control, or to exfiltrate data.",
            "useCase": "malware",
            "mitre": [
                {
                    "tacticKey": "TA0011",
                    "tactic": "Command and Control",
                    "techniqueKey": "T1105",
                    "technique": "Ingress Tool Transfer"
                }
            ],
            "sequencesExecution": "CREATION_ORDER",
            "severity": "medium",
            "sequencesConfig": {
                "sequences": [
                    {
                        "name": "",
                        "query": "process_command_line:(\"nc \",\"netcat \")",
                        "condition": {
                            "triggerOnAnyMatch": true
                        },
                        "id": "d1464f4e-be76-4327-afa4-778a1903eda8"
                    }
                ],
                "commonProperties": null,
                "outcomes": null
            },
            "scheduleConfig": null
        }
    ]
}