{
    "version": "1",
    "ruleDefinitions": [
        {
            "name": "File Ownership Changes Linux",
            "description": "This rule detects attempts to change file ownership with the 'chown' command. This could be indicative of an attacker trying to gain access to files or to hide their activities.",
            "useCase": "evasion",
            "mitre": [
                {
                    "tacticKey": "TA0005",
                    "tactic": "Defense Evasion",
                    "techniqueKey": "T1222",
                    "technique": "File and Directory Permissions Modification"
                }
            ],
            "sequencesExecution": "CREATION_ORDER",
            "severity": "low",
            "sequencesConfig": {
                "sequences": [
                    {
                        "name": "",
                        "query": "activity_type: \"process-create\" AND process_command_line:\"chown \"",
                        "condition": {
                            "triggerOnAnyMatch": true
                        },
                        "id": "c72bc0ff-3ccf-40e4-815c-92136f7b40c4"
                    }
                ],
                "commonProperties": null,
                "outcomes": null
            },
            "scheduleConfig": null
        }
    ]
}