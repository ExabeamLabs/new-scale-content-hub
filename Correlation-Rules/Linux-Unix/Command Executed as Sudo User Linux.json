{
    "version": "1",
    "ruleDefinitions": [
        {
            "name": "Command Executed as Sudo User Linux",
            "description": "This rule detects attempts to execute commands as another user with the 'sudo' command. This could be indicative of an attacker trying to escalate privileges.",
            "useCase": "privilege_escalation",
            "mitre": [
                {
                    "tacticKey": "TA0002",
                    "tactic": "Execution",
                    "techniqueKey": "T1059",
                    "technique": "Command and Scripting Interpreter"
                },
                {
                    "tacticKey": "TA0001",
                    "tactic": "Initial Access",
                    "techniqueKey": "T1078",
                    "technique": "Valid Accounts"
                },
                {
                    "tacticKey": "TA0003",
                    "tactic": "Persistence",
                    "techniqueKey": "T1098",
                    "technique": "Account Manipulation"
                }
            ],
            "sequencesExecution": "CREATION_ORDER",
            "severity": "low",
            "sequencesConfig": {
                "sequences": [
                    {
                        "name": "",
                        "query": "process_command_line:(\"sudo\")",
                        "condition": {
                            "groupByOption": true,
                            "groupBy": [
                                "user"
                            ],
                            "functionType": "count",
                            "subject": "event",
                            "field": "",
                            "operator": "more_than",
                            "value": "0",
                            "time": 20,
                            "unit": "m",
                            "triggerOnAnyMatch": false
                        },
                        "id": "6d587611-964d-4ba8-b879-5328fee9b53e"
                    }
                ],
                "commonProperties": null,
                "outcomes": null
            },
            "scheduleConfig": null
        }
    ]
}