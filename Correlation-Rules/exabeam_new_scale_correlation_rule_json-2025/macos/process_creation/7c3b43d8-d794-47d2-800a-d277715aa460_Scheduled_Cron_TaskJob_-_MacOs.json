{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Scheduled Cron Task/Job - MacOs",
      "description": "Detects abuse of the cron utility to perform task scheduling for initial or recurring execution of malicious code. Detection will focus on crontab jobs uploaded from the tmp folder.",
      "useCase": "abnormal process execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\/crontab$\") AND process_command_line = RGX(\".*\\\\/tmp\\\\/.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "225183f5-4964-4dea-9689-192613f2de7f"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}