{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "System Integrity Protection (SIP) Enumeration",
      "description": "Detects the use of csrutil to view the Configure System Integrity Protection (SIP) status. This technique is used in post-exploit scenarios.\n",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\/csrutil$\") AND process_command_line = RGX(\".*status.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "58f4a093-8040-4120-a955-c59d7dde5ad0"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}