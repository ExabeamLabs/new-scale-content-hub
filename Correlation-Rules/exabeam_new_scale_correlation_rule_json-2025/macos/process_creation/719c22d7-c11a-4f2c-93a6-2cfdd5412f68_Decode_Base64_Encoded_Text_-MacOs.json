{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Decode Base64 Encoded Text -MacOs",
      "description": "Detects usage of base64 utility to decode arbitrary base64-encoded text",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = \"\\/usr\\/bin\\/base64\" AND process_command_line = RGX(\".*\\\\-d.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "5bae3720-d700-47ff-896e-958567723983"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}