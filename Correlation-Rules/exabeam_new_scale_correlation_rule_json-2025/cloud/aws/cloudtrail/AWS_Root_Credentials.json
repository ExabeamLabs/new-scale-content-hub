{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "AWS Root Credentials",
      "description": "Detects AWS root account usage Note: Unmapped fields: userIdentity.type, eventType",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "userIdentity.type = \"Root\" AND  NOT (eventType = \"AwsServiceEvent\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "c5ebee7c-ee90-45f1-b7f7-e9c138f6feca"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}
