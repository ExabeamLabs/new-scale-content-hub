      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(event_id = 8001 AND TargetName = RGX(\"^TERMSRV\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "9a336640-915c-47ad-9e5a-ae50daf919a3"
