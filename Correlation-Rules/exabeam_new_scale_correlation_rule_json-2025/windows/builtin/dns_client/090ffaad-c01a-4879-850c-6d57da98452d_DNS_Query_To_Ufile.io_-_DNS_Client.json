{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "DNS Query To Ufile.io - DNS Client",
      "description": "Detects DNS queries to \"ufile.io\", which was seen abused by malware and threat actors as a method for data exfiltration Note: Unmapped fields: QueryName",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(event_id = 3008 AND QueryName = RGX(\".*ufile\\\\\\.io.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "d4b5e6a6-13e4-4559-8dc9-a84432ea68c5"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}