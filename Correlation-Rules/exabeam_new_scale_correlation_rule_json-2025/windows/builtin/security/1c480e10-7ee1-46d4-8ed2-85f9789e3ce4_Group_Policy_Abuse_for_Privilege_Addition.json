{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Group Policy Abuse for Privilege Addition",
      "description": "Detects the first occurrence of a modification to Group Policy Object Attributes to add privileges to user accounts or use them to add users as local admins.\n Note: Unmapped fields: AttributeLDAPDisplayName, AttributeValue",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(event_id = 5136 AND AttributeLDAPDisplayName = \"gPCMachineExtensionNames\" AND (AttributeValue = RGX(\".*827D319E\\\\-6EAC\\\\-11D2\\\\-A4EA\\\\-00C04F79F83A.*\") OR AttributeValue = RGX(\".*803E14A0\\\\-B4FB\\\\-11D0\\\\-A0D0\\\\-00A0C90F574B.*\")))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "b8b20847-f0ed-4a99-ba0b-0ef33942936a"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}