{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Writing Local Admin Share",
      "description": "Aversaries may use to interact with a remote network share using Server Message Block (SMB).\nThis technique is used by post-exploitation frameworks.\n",
      "useCase": "privilege escalation",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(file_path = RGX(\".*\\\\\\\\\\\\\\\\127\\\\\\.0\\\\\\.0.*\") AND file_path = RGX(\".*\\\\\\\\ADMIN\\\\$\\\\\\\\.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "617ee147-066c-4a86-93e5-9ee19bbf1e95"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}