{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "NTDS Exfiltration Filename Patterns",
      "description": "Detects creation of files with specific name patterns seen used in various tools that export the NTDS.DIT for exfiltration.",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(file_path = RGX(\"\\\\\\\\All\\\\\\.cab$\") OR file_path = RGX(\"\\\\\\.ntds\\\\\\.cleartext$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "b44662de-4758-4f8b-8eef-302109b1ef87"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}