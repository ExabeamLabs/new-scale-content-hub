{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Rclone Config File Creation",
      "description": "Detects Rclone config files being created",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(file_path = RGX(\".*\\\\:\\\\\\\\Users\\\\\\\\.*\") AND file_path = RGX(\".*\\\\\\\\\\\\\\.config\\\\\\\\rclone\\\\\\\\.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "f13207d5-829c-426a-a058-5084e6ab9549"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}