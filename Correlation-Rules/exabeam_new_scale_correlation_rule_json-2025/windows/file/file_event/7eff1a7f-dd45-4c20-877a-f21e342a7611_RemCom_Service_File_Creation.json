{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "RemCom Service File Creation",
      "description": "Detects default RemCom service filename which indicates RemCom service installation and execution",
      "useCase": "abnormal process execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "file_path = RGX(\"\\\\\\\\RemComSvc\\\\\\.exe$\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "ab46971d-2724-4459-8b90-a090d165b4f2"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}