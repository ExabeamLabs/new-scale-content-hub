{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Hijack Legit RDP Session to Move Laterally",
      "description": "Detects the usage of tsclient share to place a backdoor on the RDP source machine's startup folder",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\\\\\mstsc\\\\\\.exe$\") AND file_path = RGX(\".*\\\\\\\\Microsoft\\\\\\\\Windows\\\\\\\\Start\\\\ Menu\\\\\\\\Programs\\\\\\\\Startup\\\\\\\\.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "6023fe8b-b3b2-45de-b1a8-ed2264f52d48"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}