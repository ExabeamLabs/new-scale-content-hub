{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Suspicious Interactive PowerShell as SYSTEM",
      "description": "Detects the creation of files that indicator an interactive use of PowerShell in the SYSTEM user context",
      "useCase": "privilege escalation",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(file_path = \"C\\:\\\\Windows\\\\System32\\\\config\\\\systemprofile\\\\AppData\\\\Roaming\\\\Microsoft\\\\Windows\\\\PowerShell\\\\PSReadLine\\\\ConsoleHost\\_history\\.txt\" OR file_path = \"C\\:\\\\Windows\\\\System32\\\\config\\\\systemprofile\\\\AppData\\\\Local\\\\Microsoft\\\\Windows\\\\PowerShell\\\\StartupProfileData\\-Interactive\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "1b06a69f-4860-4a3e-a246-ee08733dac31"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}