{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Invoke-Obfuscation Via Stdin - Powershell",
      "description": "Detects Obfuscated Powershell via Stdin in Scripts Note: Unmapped fields: ScriptBlockText",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "ScriptBlockText = RGX(\"(?i)(set).*&&\\s?set.*(environment|invoke|${?input).*&&.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "8257e60e-287f-498f-9097-aab37cd307cc"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}