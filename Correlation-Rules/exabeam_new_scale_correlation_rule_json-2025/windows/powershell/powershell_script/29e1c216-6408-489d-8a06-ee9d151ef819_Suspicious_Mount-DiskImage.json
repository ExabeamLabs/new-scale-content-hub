{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Suspicious Mount-DiskImage",
      "description": "Adversaries may abuse container files such as disk image (.iso, .vhd) file formats to deliver malicious payloads that may not be tagged with MOTW. Note: Unmapped fields: ScriptBlockText",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(ScriptBlockText = RGX(\".*Mount\\\\-DiskImage\\\\ .*\") AND ScriptBlockText = RGX(\".*\\\\-ImagePath\\\\ .*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "857d7e67-d18b-4f2e-88dc-9ce874fcfe6a"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}