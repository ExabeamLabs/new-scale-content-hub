  "ruleDefinitions": [
    {
      "name": "Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION - PowerShell",
      "description": "Detects Obfuscated Powershell via VAR++ LAUNCHER Note: Unmapped fields: ScriptBlockText",
      "useCase": "evasion",
