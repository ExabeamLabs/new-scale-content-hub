      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "ScriptBlockText = RGX(\"(?i)&&set.*({\\d}){2,}\\\"\\s+?-f.*&&.*cmd.*/c\")",
            "condition": {
              "triggerOnAnyMatch": true
