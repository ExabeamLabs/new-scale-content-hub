{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential COM Objects Download Cradles Usage - PS Script",
      "description": "Detects usage of COM objects that can be abused to download files in PowerShell by CLSID Note: Unmapped fields: ScriptBlockText",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(ScriptBlockText = RGX(\".*\\\\[Type\\\\]\\\\:\\\\:GetTypeFromCLSID\\\\(.*\") AND (ScriptBlockText = RGX(\".*0002DF01\\\\-0000\\\\-0000\\\\-C000\\\\-000000000046.*\") OR ScriptBlockText = RGX(\".*F6D90F16\\\\-9C73\\\\-11D3\\\\-B32E\\\\-00C04F990BB4.*\") OR ScriptBlockText = RGX(\".*F5078F35\\\\-C551\\\\-11D3\\\\-89B9\\\\-0000F81FE221.*\") OR ScriptBlockText = RGX(\".*88d96a0a\\\\-f192\\\\-11d4\\\\-a65f\\\\-0040963251e5.*\") OR ScriptBlockText = RGX(\".*AFBA6B42\\\\-5692\\\\-48EA\\\\-8141\\\\-DC517DCF0EF1.*\") OR ScriptBlockText = RGX(\".*AFB40FFD\\\\-B609\\\\-40A3\\\\-9828\\\\-F88BBE11E4E3.*\") OR ScriptBlockText = RGX(\".*88d96a0b\\\\-f192\\\\-11d4\\\\-a65f\\\\-0040963251e5.*\") OR ScriptBlockText = RGX(\".*2087c2f4\\\\-2cef\\\\-4953\\\\-a8ab\\\\-66779b670495.*\") OR ScriptBlockText = RGX(\".*000209FF\\\\-0000\\\\-0000\\\\-C000\\\\-000000000046.*\") OR ScriptBlockText = RGX(\".*00024500\\\\-0000\\\\-0000\\\\-C000\\\\-000000000046.*\")))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "f78f07c0-d5de-4906-8e74-e6a8a75d203b"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}