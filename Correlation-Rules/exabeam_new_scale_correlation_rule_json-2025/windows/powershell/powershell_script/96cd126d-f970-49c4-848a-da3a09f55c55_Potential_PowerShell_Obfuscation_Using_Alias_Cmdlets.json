{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential PowerShell Obfuscation Using Alias Cmdlets",
      "description": "Detects Set-Alias or New-Alias cmdlet usage. Which can be use as a mean to obfuscate PowerShell scripts Note: Unmapped fields: ScriptBlockText",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(ScriptBlockText = RGX(\".*Set\\\\-Alias\\\\ .*\") OR ScriptBlockText = RGX(\".*New\\\\-Alias\\\\ .*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "969125de-547d-4a8b-ad04-aec41c25c13f"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}