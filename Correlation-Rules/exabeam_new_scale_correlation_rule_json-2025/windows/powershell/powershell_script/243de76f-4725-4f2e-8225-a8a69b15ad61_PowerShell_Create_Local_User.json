{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "PowerShell Create Local User",
      "description": "Detects creation of a local user via PowerShell Note: Unmapped fields: ScriptBlockText",
      "useCase": "abnormal process execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "ScriptBlockText = RGX(\".*New\\\\-LocalUser.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "85875343-e54f-413e-a687-6bd1f4383c78"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
