{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "PowerShell Credential Prompt",
      "description": "Detects PowerShell calling a credential prompt Note: Unmapped fields: ScriptBlockText",
      "useCase": "compromised credentials",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "ScriptBlockText = RGX(\".*PromptForCredential.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "6b411d3c-f3a0-4897-b2b6-f24cb168c2ab"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}