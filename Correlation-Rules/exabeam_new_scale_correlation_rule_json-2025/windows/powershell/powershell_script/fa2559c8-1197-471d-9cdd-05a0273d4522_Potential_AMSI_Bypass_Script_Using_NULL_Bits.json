      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(ScriptBlockText = RGX(\".*if\\\\(0\\\\)\\\\{\\\\{\\\\{0\\\\}\\\\}\\\\}\\\\'\\\\ \\\\-f\\\\ \\\\$\\\\(0\\\\ \\\\-as\\\\ \\\\[char\\\\]\\\\)\\\\ \\\\+.*\") OR ScriptBlockText = RGX(\".*\\\\#\\\\<NULL\\\\>.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
