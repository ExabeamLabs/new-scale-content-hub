{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Process Creation Using Sysnative Folder",
      "description": "Detects process creation events that use the Sysnative folder (common for CobaltStrike spawns)",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_command_line = RGX(\".*\\\\:\\\\\\\\Windows\\\\\\\\Sysnative\\\\\\\\.*\") OR process_path = RGX(\".*\\\\:\\\\\\\\Windows\\\\\\\\Sysnative\\\\\\\\.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "388aa827-5792-47a7-affb-20d4249a176c"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}