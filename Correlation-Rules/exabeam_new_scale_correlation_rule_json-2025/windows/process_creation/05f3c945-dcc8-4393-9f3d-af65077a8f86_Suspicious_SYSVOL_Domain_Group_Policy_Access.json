{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Suspicious SYSVOL Domain Group Policy Access",
      "description": "Detects Access to Domain Group Policies stored in SYSVOL",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_command_line = RGX(\".*\\\\\\\\SYSVOL\\\\\\\\.*\") AND process_command_line = RGX(\".*\\\\\\\\policies\\\\\\\\.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "754dcb4a-44da-484f-8faa-f3426d72bb9c"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}