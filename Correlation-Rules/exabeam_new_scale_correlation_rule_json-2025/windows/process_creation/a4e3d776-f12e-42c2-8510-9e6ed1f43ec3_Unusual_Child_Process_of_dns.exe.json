{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Unusual Child Process of dns.exe",
      "description": "Detects an unexpected process spawning from dns.exe which may indicate activity related to remote code execution or other forms of exploitation as seen in CVE-2020-1350 (SigRed)",
      "useCase": "remote code execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "parent_process_path = RGX(\"\\\\\\\\dns\\\\\\.exe$\") AND  NOT (process_path = RGX(\"\\\\\\\\conhost\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "12259d2f-3481-466f-bc11-4deaec86c171"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}