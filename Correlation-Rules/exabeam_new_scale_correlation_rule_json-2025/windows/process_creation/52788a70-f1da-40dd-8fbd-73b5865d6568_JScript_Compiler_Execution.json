{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "JScript Compiler Execution",
      "description": "Detects the execution of the \"jsc.exe\" (JScript Compiler).\nAttacker might abuse this in order to compile JScript files on the fly and bypassing application whitelisting.\n",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\\\\\jsc\\\\\\.exe$\") OR process_original_file_name = \"jsc\\.exe\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "487997e3-8ecb-4149-9db6-bf01991b7aca"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}