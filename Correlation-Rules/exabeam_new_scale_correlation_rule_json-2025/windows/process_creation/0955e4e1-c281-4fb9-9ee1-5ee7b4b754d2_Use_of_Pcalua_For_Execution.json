{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Use of Pcalua For Execution",
      "description": "Detects execition of commands and binaries from the context of The program compatibility assistant (Pcalua.exe). This can be used as a LOLBIN in order to bypass application whitelisting.",
      "useCase": "abnormal process execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\\\\\pcalua\\\\\\.exe$\") AND process_command_line = RGX(\".*\\\\ \\\\-a.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "0ec35e34-25f0-475d-8ff7-6cd77d1413f2"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}