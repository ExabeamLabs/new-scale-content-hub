{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Renamed MegaSync Execution",
      "description": "Detects the execution of a renamed MegaSync.exe as seen used by ransomware families like Nefilim, Sodinokibi, Pysa, and Conti.",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_original_file_name = \"megasync\\.exe\" AND  NOT (process_path = RGX(\"\\\\\\\\megasync\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "25299af9-5c66-47a1-bd4a-fea30b42ac7b"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}