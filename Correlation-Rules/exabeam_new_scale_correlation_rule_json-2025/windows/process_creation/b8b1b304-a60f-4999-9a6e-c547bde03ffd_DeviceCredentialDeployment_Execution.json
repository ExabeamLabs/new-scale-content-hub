{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "DeviceCredentialDeployment Execution",
      "description": "Detects the execution of DeviceCredentialDeployment to hide a process from view",
      "useCase": "compromised credentials",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_path = RGX(\"\\\\\\\\DeviceCredentialDeployment\\\\\\.exe$\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "76e1385d-25bf-4b4b-a6bc-9dd9a81fe73d"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}