{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Uncommon Child Process Spawned By Odbcconf.EXE",
      "description": "Detects an uncommon child process of \"odbcconf.exe\" binary which normally shouldn't have any child processes.",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "parent_process_path = RGX(\"\\\\\\\\odbcconf\\\\\\.exe$\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "bbac1954-1a99-4065-a923-f2b4f8e698d0"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}