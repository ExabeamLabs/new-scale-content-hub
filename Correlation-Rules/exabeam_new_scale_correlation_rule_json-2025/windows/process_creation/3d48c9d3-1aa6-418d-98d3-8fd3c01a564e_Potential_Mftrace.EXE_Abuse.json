{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Mftrace.EXE Abuse",
      "description": "Detects child processes of the \"Trace log generation tool for Media Foundation Tools\" (Mftrace.exe) which can abused to execute arbitrary binaries.",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "parent_process_path = RGX(\"\\\\\\\\mftrace\\\\\\.exe$\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "f5f00893-bd58-4b80-908c-2360bcddea51"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}