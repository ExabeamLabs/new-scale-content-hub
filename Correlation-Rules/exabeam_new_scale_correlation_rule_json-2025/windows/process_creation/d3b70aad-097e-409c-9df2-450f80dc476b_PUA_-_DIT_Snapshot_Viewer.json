{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "PUA - DIT Snapshot Viewer",
      "description": "Detects the use of Ditsnap tool, an inspection tool for Active Directory database, ntds.dit.",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\\\\\ditsnap\\\\\\.exe$\") OR process_command_line = RGX(\".*ditsnap\\\\\\.exe.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "36821e86-d066-4dac-8d1d-2058253bb57e"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}