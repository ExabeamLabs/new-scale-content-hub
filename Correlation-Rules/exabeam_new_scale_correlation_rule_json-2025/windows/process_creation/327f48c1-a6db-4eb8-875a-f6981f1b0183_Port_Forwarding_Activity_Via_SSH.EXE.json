{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Port Forwarding Activity Via SSH.EXE",
      "description": "Detects port forwarding activity via SSH.exe",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\\\\\ssh\\\\\\.exe$\") AND process_command_line = RGX(\".*\\\\ \\\\-R\\\\ .*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "78eb7cc4-6a7d-4f98-beb6-b47e9800c3ec"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}