{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Renamed Whoami Execution",
      "description": "Detects the execution of whoami that has been renamed to a different name to avoid detection",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "critical",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_original_file_name = \"whoami\\.exe\" AND  NOT (process_path = RGX(\"\\\\\\\\whoami\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "98e3b5cc-18f5-4f56-b350-4333e8029de9"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}