{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Credential Dumping Attempt Using New NetworkProvider - CLI",
      "description": "Detects when an attacker tries to add a new network provider in order to dump clear text credentials, similar to how the NPPSpy tool does it",
      "useCase": "privilege escalation",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_command_line = RGX(\".*\\\\\\\\System\\\\\\\\CurrentControlSet\\\\\\\\Services\\\\\\\\.*\") AND process_command_line = RGX(\".*\\\\\\\\NetworkProvider.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "926d801d-aeca-4ac0-b0e1-357c087e0d5e"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}