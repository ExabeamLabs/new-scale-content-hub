{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Renamed BOINC Client Execution",
      "description": "Detects the execution of a renamed BOINC binary.",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_original_file_name = \"BOINC\\.exe\" AND  NOT (process_path = RGX(\"\\\\\\\\BOINC\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "268b32b7-b56a-4d63-a6fd-cc14293df973"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}