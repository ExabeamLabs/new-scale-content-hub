{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Renamed Vmnat.exe Execution",
      "description": "Detects renamed vmnat.exe or portable version that can be used for DLL side-loading",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_original_file_name = \"vmnat\\.exe\" AND  NOT (process_path = RGX(\"vmnat\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "70328e7b-67c6-466c-8a8e-4214e2e23f18"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}