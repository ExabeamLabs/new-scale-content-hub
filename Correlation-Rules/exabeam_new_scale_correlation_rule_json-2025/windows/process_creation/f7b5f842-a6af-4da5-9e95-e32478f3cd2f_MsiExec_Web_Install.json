{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "MsiExec Web Install",
      "description": "Detects suspicious msiexec process starts with web addresses as parameter",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_command_line = RGX(\".*\\\\ msiexec.*\") AND process_command_line = RGX(\".*\\\\:\\\\/\\\\/.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "0e6f88e7-4635-480c-b413-b81c1263fbd3"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}