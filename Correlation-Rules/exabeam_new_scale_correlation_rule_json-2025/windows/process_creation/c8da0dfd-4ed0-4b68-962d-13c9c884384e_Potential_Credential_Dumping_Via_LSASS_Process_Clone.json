{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Credential Dumping Via LSASS Process Clone",
      "description": "Detects a suspicious LSASS process process clone that could be a sign of credential dumping activity",
      "useCase": "privilege escalation",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "critical",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(parent_process_path = RGX(\"\\\\\\\\Windows\\\\\\\\System32\\\\\\\\lsass\\\\\\.exe$\") AND process_path = RGX(\"\\\\\\\\Windows\\\\\\\\System32\\\\\\\\lsass\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "55be2996-f6f5-42ab-b77f-b2ea0dd4a702"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}