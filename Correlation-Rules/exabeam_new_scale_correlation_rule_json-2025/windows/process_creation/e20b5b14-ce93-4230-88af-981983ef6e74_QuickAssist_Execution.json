{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "QuickAssist Execution",
      "description": "Detects the execution of Microsoft Quick Assist tool \"QuickAssist.exe\". This utility can be used by attackers to gain remote access.\n",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_path = RGX(\"\\\\\\\\QuickAssist\\\\\\.exe$\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "84d375d2-fa43-4ead-ab61-e12fddef510c"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}