{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Uncommon Child Process Of Defaultpack.EXE",
      "description": "Detects uncommon child processes of \"DefaultPack.EXE\" binary as a proxy to launch other programs",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "parent_process_path = RGX(\"\\\\\\\\DefaultPack\\\\\\.exe$\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "85bc673b-90a2-4b50-b364-bb385910a24e"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}