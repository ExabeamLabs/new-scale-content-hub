      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(parent_process_path = RGX(\"\\\\\\\\bginfo\\\\\\.exe$\") OR parent_process_path = RGX(\"\\\\\\\\bginfo64\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "8e85c171-c375-442f-961d-86e6f6e0afc4"
          }
        ],
        "commonProperties": null,
