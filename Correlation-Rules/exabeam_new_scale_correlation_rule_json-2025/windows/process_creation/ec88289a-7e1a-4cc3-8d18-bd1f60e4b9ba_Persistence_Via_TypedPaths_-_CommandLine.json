{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Persistence Via TypedPaths - CommandLine",
      "description": "Detects modification addition to the 'TypedPaths' key in the user or admin registry via the commandline. Which might indicate persistence attempt",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_command_line = RGX(\".*\\\\\\\\Software\\\\\\\\Microsoft\\\\\\\\Windows\\\\\\\\CurrentVersion\\\\\\\\Explorer\\\\\\\\TypedPaths.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "117a3d21-6eee-48ee-a793-c6ca924abba6"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}