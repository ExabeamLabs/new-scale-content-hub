{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Provisioning Registry Key Abuse For Binary Proxy Execution",
      "description": "Detects potential abuse of the provisioning registry key for indirect command execution through \"Provlaunch.exe\".",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_command_line = RGX(\".*SOFTWARE\\\\\\\\Microsoft\\\\\\\\Provisioning\\\\\\\\Commands\\\\\\\\.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "b1217873-99b1-4717-92ad-7f464e8a3b62"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}