{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Renamed BrowserCore.EXE Execution",
      "description": "Detects process creation with a renamed BrowserCore.exe (used to extract Azure tokens)",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_original_file_name = \"BrowserCore\\.exe\" AND  NOT (process_path = RGX(\"\\\\\\\\BrowserCore\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "e16cf537-e27b-488c-b5a2-6a0d1a455c05"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}