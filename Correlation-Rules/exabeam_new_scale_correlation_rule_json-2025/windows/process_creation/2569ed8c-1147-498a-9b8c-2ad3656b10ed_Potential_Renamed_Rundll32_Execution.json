{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Renamed Rundll32 Execution",
      "description": "Detects when 'DllRegisterServer' is called in the commandline and the image is not rundll32. This could mean that the 'rundll32' utility has been renamed in order to avoid detection",
      "useCase": "abnormal process execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_command_line = RGX(\".*DllRegisterServer.*\") AND  NOT (process_path = RGX(\"\\\\\\\\rundll32\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "e49ec6cb-e3f8-4455-8fb5-db68a0eb3f80"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}