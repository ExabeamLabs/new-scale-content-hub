{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Remote Access Tool - ScreenConnect Server Web Shell Execution",
      "description": "Detects potential web shell execution from the ScreenConnect server process.",
      "useCase": "remote code execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(parent_process_path = RGX(\"\\\\\\\\ScreenConnect\\\\\\.Service\\\\\\.exe$\") AND (process_path = RGX(\"\\\\\\\\cmd\\\\\\.exe$\") OR process_path = RGX(\"\\\\\\\\csc\\\\\\.exe$\")))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "47526d79-71ed-4914-b4af-1907408e6b35"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}