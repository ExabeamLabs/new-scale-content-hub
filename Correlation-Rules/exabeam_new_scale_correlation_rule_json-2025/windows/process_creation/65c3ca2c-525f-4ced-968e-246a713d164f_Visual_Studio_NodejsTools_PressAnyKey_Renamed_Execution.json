{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Visual Studio NodejsTools PressAnyKey Renamed Execution",
      "description": "Detects renamed execution of \"Microsoft.NodejsTools.PressAnyKey.exe\", which can be abused as a LOLBIN to execute arbitrary binaries",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_original_file_name = \"Microsoft\\.NodejsTools\\.PressAnyKey\\.exe\" AND  NOT (process_path = RGX(\"\\\\\\\\Microsoft\\\\\\.NodejsTools\\\\\\.PressAnyKey\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "43aa7fbb-72f6-4d29-b087-7d43f2f64714"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}