{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Procdump Execution",
      "description": "Detects usage of the SysInternals Procdump utility",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\\\\\procdump\\\\\\.exe$\") OR process_path = RGX(\"\\\\\\\\procdump64\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "1c8896ff-9bfa-4269-a826-fd38b7ae7e33"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
