            "name": "",
            "query": "process_command_line = RGX(\".*\\\\-NoP\\\\ \\\\-NoL\\\\ \\\\-sta\\\\ \\\\-NonI\\\\ \\\\-W\\\\ Hidden\\\\ \\\\-Exec\\\\ Bypass\\\\ \\\\-Enc.*\")",
            "condition": {
              "triggerOnAnyMatch": true
