{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "HackTool - Wmiexec Default Powershell Command",
      "description": "Detects the execution of PowerShell with a specific flag sequence that is used by the Wmiexec script",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
