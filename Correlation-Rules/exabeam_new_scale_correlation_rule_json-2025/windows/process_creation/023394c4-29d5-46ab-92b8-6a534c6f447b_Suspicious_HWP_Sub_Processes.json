{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Suspicious HWP Sub Processes",
      "description": "Detects suspicious Hangul Word Processor (Hanword) sub processes that could indicate an exploitation",
      "useCase": "abnormal process execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(parent_process_path = RGX(\"\\\\\\\\Hwp\\\\\\.exe$\") AND process_path = RGX(\"\\\\\\\\gbb\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "ff0df7ae-dd4d-4cac-a154-03e3f9cd511c"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}