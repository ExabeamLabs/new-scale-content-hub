{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "New PortProxy Registry Entry Added",
      "description": "Detects the modification of the PortProxy registry key which is used for port forwarding.",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "registry_path = RGX(\".*\\\\\\\\Services\\\\\\\\PortProxy\\\\\\\\v4tov4\\\\\\\\tcp\\\\\\\\.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "4da22066-3734-4b8e-9cad-893bcc6eb4be"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}