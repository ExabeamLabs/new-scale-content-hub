{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Credential Dumping Via LSASS SilentProcessExit Technique",
      "description": "Detects changes to the Registry in which a monitor program gets registered to dump the memory of the lsass.exe process",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "critical",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "registry_path = RGX(\".*Microsoft\\\\\\\\Windows\\\\ NT\\\\\\\\CurrentVersion\\\\\\\\SilentProcessExit\\\\\\\\lsass\\\\\\.exe.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "462bb81e-eab6-4608-a1e4-f3118c879ad2"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}