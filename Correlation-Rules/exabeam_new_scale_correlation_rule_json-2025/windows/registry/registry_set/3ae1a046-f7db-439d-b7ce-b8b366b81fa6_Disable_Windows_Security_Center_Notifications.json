{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Disable Windows Security Center Notifications",
      "description": "Detect set UseActionCenterExperience to 0 to disable the Windows security center notification Note: Unmapped fields: Details",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(registry_path = RGX(\"Windows\\\\\\\\CurrentVersion\\\\\\\\ImmersiveShell\\\\\\\\UseActionCenterExperience$\") AND Details = \"DWORD\\ \\(0x00000000\\)\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "d1e512ce-9cf7-43c5-bfdc-28dc810b067d"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}