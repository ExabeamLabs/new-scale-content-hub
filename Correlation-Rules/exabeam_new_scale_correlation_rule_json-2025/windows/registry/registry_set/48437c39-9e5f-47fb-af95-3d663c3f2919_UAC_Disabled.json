{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "UAC Disabled",
      "description": "Detects when an attacker tries to disable User Account Control (UAC) by setting the registry value \"EnableLUA\" to 0.\n Note: Unmapped fields: Details",
      "useCase": "privilege escalation",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(registry_path = RGX(\".*\\\\\\\\Microsoft\\\\\\\\Windows\\\\\\\\CurrentVersion\\\\\\\\Policies\\\\\\\\System\\\\\\\\EnableLUA.*\") AND Details = \"DWORD\\ \\(0x00000000\\)\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "d41200eb-f586-4446-8076-9bda39e41b05"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}