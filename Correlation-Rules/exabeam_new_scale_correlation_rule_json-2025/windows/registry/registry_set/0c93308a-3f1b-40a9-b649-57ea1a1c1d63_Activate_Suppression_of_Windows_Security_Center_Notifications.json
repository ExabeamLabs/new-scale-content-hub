{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Activate Suppression of Windows Security Center Notifications",
      "description": "Detect set Notification_Suppress to 1 to disable the Windows security center notification Note: Unmapped fields: Details",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(registry_path = RGX(\"SOFTWARE\\\\\\\\Policies\\\\\\\\Microsoft\\\\\\\\Windows\\\\ Defender\\\\\\\\UX\\\\ Configuration\\\\\\\\Notification\\\\_Suppress$\") AND Details = \"DWORD\\ \\(0x00000001\\)\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "917db70e-ff21-4939-8d36-1a056251f0b8"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}