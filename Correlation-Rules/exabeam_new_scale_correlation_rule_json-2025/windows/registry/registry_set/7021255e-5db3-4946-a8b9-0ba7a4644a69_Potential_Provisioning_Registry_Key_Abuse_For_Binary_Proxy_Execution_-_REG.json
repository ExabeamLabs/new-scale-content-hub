{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Provisioning Registry Key Abuse For Binary Proxy Execution - REG",
      "description": "Detects potential abuse of the provisioning registry key for indirect command execution through \"Provlaunch.exe\".",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "registry_path = RGX(\".*\\\\\\\\SOFTWARE\\\\\\\\Microsoft\\\\\\\\Provisioning\\\\\\\\Commands\\\\\\\\.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "ad12bba5-7067-4b19-91ca-68fdf1d2ef84"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}