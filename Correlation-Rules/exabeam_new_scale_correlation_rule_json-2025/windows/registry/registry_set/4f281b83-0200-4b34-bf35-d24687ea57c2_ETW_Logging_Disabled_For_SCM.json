{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "ETW Logging Disabled For SCM",
      "description": "Detects changes to the \"TracingDisabled\" key in order to disable ETW logging for services.exe (SCM) Note: Unmapped fields: Details",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(registry_path = RGX(\"Software\\\\\\\\Microsoft\\\\\\\\Windows\\\\ NT\\\\\\\\CurrentVersion\\\\\\\\Tracing\\\\\\\\SCM\\\\\\\\Regular\\\\\\\\TracingDisabled$\") AND Details = \"DWORD\\ \\(0x00000001\\)\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "821286e5-37e2-4e5e-9eb1-51b362c3c391"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}