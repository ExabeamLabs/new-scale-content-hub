{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential EventLog File Location Tampering",
      "description": "Detects tampering with EventLog service \"file\" key. In order to change the default location of an Evtx file. This technique is used to tamper with log collection and alerting Note: Unmapped fields: Details",
      "useCase": "privilege escalation",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(registry_path = RGX(\".*\\\\\\\\SYSTEM\\\\\\\\CurrentControlSet\\\\\\\\Services\\\\\\\\EventLog\\\\\\\\.*\") AND registry_path = RGX(\"\\\\\\\\File$\")) AND  NOT (Details = RGX(\".*\\\\\\\\System32\\\\\\\\Winevt\\\\\\\\Logs\\\\\\\\.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "636cb6fd-b45e-409a-a5d5-a1bee98b8b51"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}