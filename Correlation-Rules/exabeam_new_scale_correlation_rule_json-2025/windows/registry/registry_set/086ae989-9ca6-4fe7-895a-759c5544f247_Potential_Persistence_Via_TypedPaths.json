{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Persistence Via TypedPaths",
      "description": "Detects modification addition to the 'TypedPaths' key in the user or admin registry from a non standard application. Which might indicate persistence attempt",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "registry_path = RGX(\".*\\\\\\\\Software\\\\\\\\Microsoft\\\\\\\\Windows\\\\\\\\CurrentVersion\\\\\\\\Explorer\\\\\\\\TypedPaths\\\\\\\\.*\") AND  NOT ((process_path = \"C\\:\\\\Windows\\\\explorer\\.exe\" OR process_path = \"C\\:\\\\Windows\\\\SysWOW64\\\\explorer\\.exe\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "68be617a-d5b9-4d95-a4a8-02c13d8a49a8"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}