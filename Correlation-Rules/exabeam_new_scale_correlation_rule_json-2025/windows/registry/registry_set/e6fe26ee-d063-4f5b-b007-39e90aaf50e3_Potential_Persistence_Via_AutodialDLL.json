{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential Persistence Via AutodialDLL",
      "description": "Detects change the the \"AutodialDLL\" key which could be used as a persistence method to load custom DLL via the \"ws2_32\" library",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "registry_path = RGX(\".*\\\\\\\\Services\\\\\\\\WinSock2\\\\\\\\Parameters\\\\\\\\AutodialDLL.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "69318aac-764e-420d-9876-e16b747e5b97"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}