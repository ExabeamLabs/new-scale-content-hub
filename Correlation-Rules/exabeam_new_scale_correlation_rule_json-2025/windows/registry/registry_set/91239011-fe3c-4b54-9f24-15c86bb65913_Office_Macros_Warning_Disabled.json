{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Office Macros Warning Disabled",
      "description": "Detects registry changes to Microsoft Office \"VBAWarning\" to a value of \"1\" which enables the execution of all macros, whether signed or unsigned. Note: Unmapped fields: Details",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(registry_path = RGX(\"\\\\\\\\Security\\\\\\\\VBAWarnings$\") AND Details = \"DWORD\\ \\(0x00000001\\)\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "18880fb1-e195-40a4-9156-efcf98e30852"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}