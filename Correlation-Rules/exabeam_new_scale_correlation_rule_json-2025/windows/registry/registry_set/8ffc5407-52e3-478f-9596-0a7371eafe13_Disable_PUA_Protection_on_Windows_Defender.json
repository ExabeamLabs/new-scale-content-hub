{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Disable PUA Protection on Windows Defender",
      "description": "Detects disabling Windows Defender PUA protection Note: Unmapped fields: Details",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(registry_path = RGX(\".*\\\\\\\\Policies\\\\\\\\Microsoft\\\\\\\\Windows\\\\ Defender\\\\\\\\PUAProtection.*\") AND Details = \"DWORD\\ \\(0x00000000\\)\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "3f23a012-05ed-4afc-ac4a-2ae9b38bd61e"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}