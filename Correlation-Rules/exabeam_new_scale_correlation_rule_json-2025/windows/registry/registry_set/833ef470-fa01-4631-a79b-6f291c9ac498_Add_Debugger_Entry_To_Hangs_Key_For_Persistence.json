{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Add Debugger Entry To Hangs Key For Persistence",
      "description": "Detects when an attacker adds a new \"Debugger\" value to the \"Hangs\" key in order to achieve persistence which will get invoked when an application crashes",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "registry_path = RGX(\".*\\\\\\\\SOFTWARE\\\\\\\\Microsoft\\\\\\\\Windows\\\\\\\\Windows\\\\ Error\\\\ Reporting\\\\\\\\Hangs\\\\\\\\Debugger.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "5ece1015-d6ca-42fa-b59b-3daf90342ace"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}