{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Outlook Security Settings Updated - Registry",
      "description": "Detects changes to the registry values related to outlook security settings",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(registry_path = RGX(\".*\\\\\\\\SOFTWARE\\\\\\\\Microsoft\\\\\\\\Office\\\\\\\\.*\") AND registry_path = RGX(\".*\\\\\\\\Outlook\\\\\\\\Security\\\\\\\\.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "431c0e6e-1a91-4ec3-a1ae-c06b74ea5817"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}