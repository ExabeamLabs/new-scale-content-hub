{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Change User Account Associated with the FAX Service",
      "description": "Detect change of the user account associated with the FAX service to avoid the escalation problem. Note: Unmapped fields: Details",
      "useCase": "privilege escalation",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "registry_path = \"HKLM\\\\System\\\\CurrentControlSet\\\\Services\\\\Fax\\\\ObjectName\" AND  NOT (Details = RGX(\".*NetworkService.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "283bb316-e2be-48d8-a212-ff4468d1087d"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}