{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potential RjvPlatform.DLL Sideloading From Non-Default Location",
      "description": "Detects potential DLL sideloading of \"RjvPlatform.dll\" by \"SystemResetPlatform.exe\" located in a non-default location. Note: Unmapped fields: ImageLoaded",
      "useCase": "privilege escalation",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "high",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(ImageLoaded = RGX(\"\\\\\\\\RjvPlatform\\\\\\.dll$\") AND process_path = \"\\\\SystemResetPlatform\\.exe\") AND  NOT (process_path = RGX(\"^C\\\\:\\\\\\\\Windows\\\\\\\\System32\\\\\\\\SystemResetPlatform\\\\\\\\\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "9206d016-dc41-453c-a62d-b4ddf81d5330"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}