{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "DNS Query Request By Regsvr32.EXE",
      "description": "Detects DNS queries initiated by \"Regsvr32.exe\"",
      "useCase": "evasion",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_path = RGX(\"\\\\\\\\regsvr32\\\\\\.exe$\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "0a71662e-d741-46ab-9561-a523160f9f2c"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
