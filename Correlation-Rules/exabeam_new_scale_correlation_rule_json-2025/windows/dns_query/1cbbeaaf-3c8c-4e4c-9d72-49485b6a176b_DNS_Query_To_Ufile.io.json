      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "QueryName = RGX(\".*ufile\\\\\\.io.*\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "3b9119bc-c3ee-428a-8849-8d5e65ec8763"
