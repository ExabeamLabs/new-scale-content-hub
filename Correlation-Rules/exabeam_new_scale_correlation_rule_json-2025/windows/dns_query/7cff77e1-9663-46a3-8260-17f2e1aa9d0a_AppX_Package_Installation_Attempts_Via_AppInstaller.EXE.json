{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "AppX Package Installation Attempts Via AppInstaller.EXE",
      "description": "Detects DNS queries made by \"AppInstaller.EXE\". The AppInstaller is the default handler for the \"ms-appinstaller\" URI. It attempts to load/install a package from the referenced URL\n",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"^C\\\\:\\\\\\\\Program\\\\ Files\\\\\\\\WindowsApps\\\\\\\\Microsoft\\\\\\.DesktopAppInstaller\\\\_\") AND process_path = RGX(\"\\\\\\\\AppInstaller\\\\\\.exe$\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "31291710-b65b-4fc5-aed7-c9384ef94757"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}