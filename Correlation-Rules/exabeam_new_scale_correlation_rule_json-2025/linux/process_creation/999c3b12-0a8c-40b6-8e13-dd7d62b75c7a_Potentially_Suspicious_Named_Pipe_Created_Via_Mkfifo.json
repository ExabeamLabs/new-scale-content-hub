{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Potentially Suspicious Named Pipe Created Via Mkfifo",
      "description": "Detects the creation of a new named pipe using the \"mkfifo\" utility in a potentially suspicious location",
      "useCase": "abnormal process execution",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "medium",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "(process_path = RGX(\"\\\\/mkfifo$\") AND process_command_line = RGX(\".*\\\\ \\\\/tmp\\\\/.*\"))",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "29a65613-c0e6-491d-8e26-a2832d88c77c"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}