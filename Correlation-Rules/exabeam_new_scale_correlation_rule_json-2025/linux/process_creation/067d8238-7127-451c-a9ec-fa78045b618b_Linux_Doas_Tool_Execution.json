{
  "version": "1",
  "ruleDefinitions": [
    {
      "name": "Linux Doas Tool Execution",
      "description": "Detects the doas tool execution in linux host platform. This utility tool allow standard users to perform tasks as root, the same way sudo does.",
      "useCase": "malware",
      "mitre": [],
      "sequencesExecution": "CREATION_ORDER",
      "severity": "low",
      "sequencesConfig": {
        "sequences": [
          {
            "name": "",
            "query": "process_path = RGX(\"\\\\/doas$\")",
            "condition": {
              "triggerOnAnyMatch": true
            },
            "id": "0bfaf9dc-df3c-4765-9245-19846a1f2aa3"
          }
        ],
        "commonProperties": null,
        "outcomes": null
      }
    }
  ]
}