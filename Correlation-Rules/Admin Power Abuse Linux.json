{"version":"1","ruleDefinitions":[{"name":"Admin Power Abuse Linux","description":"This rule detects attempts of admin power abuse using commands that require root privileges. This could indicate an attacker trying to gain unauthorized access or escalate privileges.","useCase":"privilege_escalation","mitre":[{"tacticKey":"TA0001","tactic":"Initial Access","techniqueKey":"T1078","technique":"Valid Accounts"},{"tacticKey":"TA0043","tactic":"Reconnaissance","techniqueKey":"T1589","technique":"Gather Victim Identity Information"}],"sequencesExecution":"CREATION_ORDER","severity":"medium","sequencesConfig":{"sequences":[{"name":"","query":"process_command_line: (\"cat /home/user/.bash_history\",\"ls /home/\",\"cat /etc/passwd\",\"cat /etc/shadow\")","condition":{"triggerOnAnyMatch":true},"id":"4ca64ba8-39cc-4e02-a0b2-90cb20c4ce9a"}],"commonProperties":null,"outcomes":null},"scheduleConfig":null}]}