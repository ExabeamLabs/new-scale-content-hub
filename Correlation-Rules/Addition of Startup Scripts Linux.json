{"version":"1","ruleDefinitions":[{"name":"Addition of Startup Scripts Linux","description":"This rule detects attempts to add startup scripts using 'echo', 'vi', 'vim' or 'nano' command. This could indicate an attacker trying to establish persistence.","useCase":"privilege_abuse","mitre":[{"tacticKey":"TA0003","tactic":"Persistence","techniqueKey":"T1547","technique":"Boot or Logon Autostart Execution"},{"tacticKey":"TA0003","tactic":"Persistence","techniqueKey":"T1037","technique":"Boot or Logon Initialization Scripts"},{"tacticKey":"TA0002","tactic":"Execution","techniqueKey":"T1059","technique":"Command and Scripting Interpreter"}],"sequencesExecution":"CREATION_ORDER","severity":"medium","sequencesConfig":{"sequences":[{"name":"","query":"process_command_line:(\"echo \",\"vi \",\"vim \",\"nano \") AND process_command_line:\">> /etc/rc.local\"","condition":{"triggerOnAnyMatch":true},"id":"5c609a0b-d01d-4328-be5b-fb3088d40a51"}],"commonProperties":null,"outcomes":null},"scheduleConfig":null}]}