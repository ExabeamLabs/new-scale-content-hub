          ],
          "platform": [
            "OpenAI"
          ]
        }
      ],
      "detectionReason": "Abnormal number (${trigger.numeric_value}) of user deletions via API key",
      "type": "numericCountProfiledFeature",
      "mitre": [
        {
          "techniqueKey": "T1531",
          "technique": "Account Access Removal",
          "tactic": "Impact",
          "tacticKey": "TA0040"
        }
      ],
      "useCases": [
