      "actOnCondition": "toLower(operation) = 'user.deleted' && toLower(credential_type) = 'api_key'",
      "query": "(activity_type = \"app-activity\") AND (platform = \"OpenAI\") AND (toLower(operation) = \"user.deleted\") AND (toLower(credential_type) = \"api_key\")",
      "scoreUnless": [],
      "suppressThreshold": "",
      "familyId": "ai-activity",
