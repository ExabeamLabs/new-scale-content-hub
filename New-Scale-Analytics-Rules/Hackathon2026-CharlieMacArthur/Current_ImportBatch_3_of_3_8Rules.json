      "name": "T1489 — fail2ban/ClamAV Killed Before Brute Force (Numeric Count)",
      "description": "fail2ban/ClamAV Killed Before Brute Force. Same identity uses sudo to stop a second security daemon within seconds",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Unix"
          ]
        }
      ],
      "detectionReason": "Abnormal number (${trigger.numeric_value}) of sudo systemctl-stop commands on ${event.host}",
      "type": "numericCountProfiledFeature",
      "mitre": [
        {
          "techniqueKey": "T1489",
          "technique": "Service Stop",
          "tactic": "Impact",
          "tacticKey": "TA0040"
        }
      ],
      "useCases": [
        "Destruction of Data"
      ],
      "trainOnCondition": "toLower(process_name) = 'sudo' && contains(toLower(process_command_line), 'stop')",
      "actOnCondition": "toLower(process_name) = 'sudo' && contains(toLower(process_command_line), 'stop')",
      "query": "(activity_type = \"process-create\") AND (platform = \"Unix\") AND (contains(toLower(process_name), \"sudo\"))",
      "scoreUnless": [],
      "suppressThreshold": "",
      "familyId": "process-creation-activity",
      "ruleGroupId": "pc-sudo-command-group",
      "severity": "Medium",
      "testMode": false,
      "scopeValue": "toLower(process_name) = 'sudo' && contains(toLower(process_command_line), 'stop')",
      "windowDuration": "90 days",
      "windowPeriod": "12 hours",
      "logBase": 2.0,
      "minOrderOfMagnitude": 32,
      "anomalyThreshold": "1 days",
      "checkScopeMaturity": false,
      "countPer": "host"
    },
    {
      "templateId": "NumDC-T1078-004-Impossible-Travel-Sign-In-5",
      "name": "T1078.004 — Impossible Travel Sign-In (Numeric Distinct Count)",
      "description": "Impossible Travel Sign-In. Two successful sign-ins for the same user from geographically-impossible locations within an implausible travel window",
      "applicableEvents": [
        {
          "activity_type": [
            "app-login"
          ],
          "category": [
            "SignInLogs"
          ],
          "platform": [
            "Microsoft 365"
          ]
        }
      ],
      "detectionReason": "Impossible travel: successive sign-ins from ${event.src_ip} shortly after a sign-in from a different country",
      "type": "numericDistinctCountProfiledFeature",
      "mitre": [
        {
          "techniqueKey": "T1078.004",
          "technique": "Valid Accounts: Cloud Accounts",
          "tactic": "Privilege Escalation",
          "tacticKey": "TA0004"
        }
      ],
      "useCases": [
        "Privilege Abuse"
      ],
      "trainOnCondition": "outcome = 'success'",
      "actOnCondition": "outcome = 'success'",
      "query": "(activity_type = \"app-login\") AND (category = \"SignInLogs\") AND (platform = \"Microsoft 365\") AND (outcome = \"success\")",
      "scoreUnless": [],
      "suppressThreshold": "",
      "familyId": "app-login-activity",
      "ruleGroupId": "al-source-endpoint-access-group",
      "severity": "Medium",
      "testMode": false,
      "featureValue": "GetGeoInfo('country', src_ip)",
      "scopeValue": "EntityId('type: User && direction: Source')",
      "windowDuration": "1 days",
      "windowPeriod": "12 hours",
      "logBase": 2.0,
      "minOrderOfMagnitude": 32,
      "anomalyThreshold": "1 days",
      "checkScopeMaturity": false,
      "checkFeatureMaturity": false
    },
    {
