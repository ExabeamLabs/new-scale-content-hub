        {
          "activity_type": [
            "secret-read"
          ],
          "platform": [
            "Azure Key Vault"
          ]
        }
      ],
      "detectionReason": "Abnormal number (${trigger.numeric_value}) of Key Vault secret retrievals from ${event.src_ip}",
      "type": "numericCountProfiledFeature",
      "mitre": [
        {
          "techniqueKey": "T1552.001",
          "technique": "Unsecured Credentials",
          "tactic": "Credential Access",
          "tacticKey": "TA0006"
        }
      ],
      "useCases": [
        "Privilege Escalation"
      ],
      "trainOnCondition": "operation = 'SecretGet' && operation_type = 'AuditEvent'",
      "actOnCondition": "operation = 'SecretGet' && operation_type = 'AuditEvent'",
      "query": "(activity_type = \"secret-read\") AND (platform = \"Azure Key Vault\") AND (operation = \"SecretGet\") AND (operation_type = \"AuditEvent\")",
      "scoreUnless": [],
      "suppressThreshold": "",
      "familyId": "password-checkout-activity",
      "ruleGroupId": "pwd-event-count-magnitude-group",
      "severity": "Medium",
      "testMode": false,
      "scopeValue": "operation = 'SecretGet' && operation_type = 'AuditEvent'",
      "windowDuration": "90 days",
      "windowPeriod": "12 hours",
      "logBase": 2.0,
      "minOrderOfMagnitude": 32,
      "anomalyThreshold": "1 days",
      "checkScopeMaturity": false,
      "countPer": "src_ip"
    },
