          ]
        }
      ],
      "detectionReason": "Login from an unusual country for this user: '${trigger.feature_value}'",
      "type": "profiledFeature",
      "mitre": [
        {
          "techniqueKey": "T1078.004",
          "technique": "Valid Accounts: Cloud Accounts",
          "tactic": "Privilege Escalation",
          "tacticKey": "TA0004"
        }
      ],
      "useCases": [
        "Privilege Abuse"
      ],
      "featureValue": "location_country",
      "scopeValue": "EntityId('type: User && direction: Source')",
      "trainOnCondition": "toLower(operation) = 'core.user_auth.login_success'",
      "actOnCondition": "toLower(operation) = 'core.user_auth.login_success'",
