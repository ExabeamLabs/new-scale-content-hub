{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1003-001-LSASS-Dump-via-rundll32-comsvcs-1",
      "name": "T1003.001 — LSASS Dump via rundll32 comsvcs (Fact #1)",
      "description": "LSASS Dump via rundll32 comsvcs. Trigger: rundll32.exe opens lsass.exe with GrantedAccess 0x1FFFFF, comsvcs.dll in call trace",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Windows"
          ],
          "event_code": [
            "10"
          ]
        }
      ],
      "requiredFields": [
        "event_code",
        "process_name",
        "parent_process_name",
        "result"
      ],
      "detectionReason": "'{parent_process_name}' opened {process_name} with GrantedAccess {result}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1003.001",
          "technique": "OS Credential Dumping",
          "tactic": "Credential Access",
          "tacticKey": "TA0006"
        }
      ],
      "useCases": [
        "Compromised Credentials"
      ],
      "value": "toLower(process_name) = 'lsass.exe' && toLower(parent_process_name) = 'rundll32.exe' && result = '0x1FFFFF'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "High",
      "testMode": false,
      "ruleGroupId": "pc-lsass-memory-dump"
    }
  ]
}