{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1005-Finance-Directory-Archived-and-Staged-30",
      "name": "T1005 — Finance Directory Archived and Staged (Fact #30)",
      "description": "Finance Directory Archived and Staged. Trigger: Privileged execution of gpg as root immediately following an archive utility",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Unix"
          ]
        }
      ],
      "requiredFields": [
        "process_path",
        "user_id"
      ],
      "detectionReason": "Privileged (root) execution of gpg on {host}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1005",
          "technique": "Data from Local System",
          "tactic": "Collection",
          "tacticKey": "TA0009"
        }
      ],
      "useCases": [
        "Evasion"
      ],
      "value": "toLower(process_path) = '/usr/bin/gpg' && user_id = '0'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-process-execution-group"
    }
  ]
}