{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1053-005-Scheduled-Task-Masquerading-as-Windows-Update-6",
      "name": "T1053.005 — Scheduled Task Masquerading as Windows Update (Fact #6)",
      "description": "Scheduled Task Masquerading as Windows Update. Trigger: schtasks.exe creates a task under \\Microsoft\\Windows\\UpdateOrchestrator\\ executing a PowerShell download cradle",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Windows"
          ],
          "event_code": [
            "1"
          ]
        }
      ],
      "requiredFields": [
        "event_code",
        "process_name",
        "process_command_line"
      ],
      "detectionReason": "schtasks.exe created a task masquerading as Windows Update: {process_command_line}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1053.005",
          "technique": "Scheduled Task/Job: Scheduled Task",
          "tactic": "Persistence",
          "tacticKey": "TA0003"
        }
      ],
      "useCases": [
        "Evasion"
      ],
      "value": "toLower(process_name) = 'schtasks.exe' && contains(toLower(process_command_line), 'updateorchestrator') && contains(toLower(process_command_line), 'powershell')",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-task-creation-group"
    }
  ]
}