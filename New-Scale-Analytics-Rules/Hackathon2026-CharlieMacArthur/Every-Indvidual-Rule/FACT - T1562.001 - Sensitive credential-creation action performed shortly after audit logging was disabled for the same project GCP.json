{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1562-001-Audit-Logging-Disabled-65",
      "name": "T1562.001 — Audit Logging Disabled (Fact #65)",
      "description": "Audit Logging Disabled. Trigger: Sensitive credential-creation action performed shortly after audit logging was disabled for the same project NOTE: the sibling Fact row ('Project IAM audit configuration overwritten to remove Data Access logging') was removed — it was byte-identical detection logic to the T1098 'GCP IAM Policy Modified via SetIamPolicy' rule; see that rule instead",
      "applicableEvents": [
        {
          "activity_type": [
            "app-activity"
          ],
          "platform": [
            "GCP"
          ]
        }
      ],
      "requiredFields": [
        "operation"
      ],
      "detectionReason": "{email_address} minted a service account key",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1562.001",
          "technique": "Impair Defenses",
          "tactic": "Defense Evasion",
          "tacticKey": "TA0005"
        }
      ],
      "useCases": [
        "Evasion"
      ],
      "value": "toLower(operation) = 'google.iam.admin.v1.createserviceaccountkey'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "EntityId('type: User && direction: Source')",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "cloud-policy-management-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "cpm-role-assign-group"
    }
  ]
}