{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1574-006-LD-PRELOAD-Hijacking-48",
      "name": "T1574.006 — LD_PRELOAD Hijacking (Fact #48)",
      "description": "LD_PRELOAD Hijacking. Trigger: echo used to write into a system linker-configuration path as root NOTE: args not captured by confirmed Unix format; inferred from context",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Unix"
          ]
        }
      ],
      "requiredFields": [
        "process_path",
        "user_id"
      ],
      "detectionReason": "Privileged (root) echo execution on {host}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1574.006",
          "technique": "Hijack Execution Flow",
          "tactic": "Defense Evasion",
          "tacticKey": "TA0005"
        }
      ],
      "useCases": [
        "Privilege Escalation"
      ],
      "value": "toLower(process_path) = '/usr/bin/echo' && user_id = '0'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-process-execution-group"
    }
  ]
}