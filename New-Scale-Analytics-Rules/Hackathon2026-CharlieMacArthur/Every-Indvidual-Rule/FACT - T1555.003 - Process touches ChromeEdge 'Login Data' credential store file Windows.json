{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1555-003-Browser-Credential-Theft-Infostealer-25",
      "name": "T1555.003 — Browser Credential Theft (Infostealer) (Fact #25)",
      "description": "Browser Credential Theft (Infostealer). Trigger: Process touches Chrome/Edge 'Login Data' credential store file",
      "applicableEvents": [
        {
          "activity_type": [
            "file-write"
          ],
          "platform": [
            "Windows"
          ],
          "event_code": [
            "11"
          ]
        }
      ],
      "requiredFields": [
        "event_code",
        "file_name"
      ],
      "detectionReason": "'{process_name}' accessed browser credential store: {file_path}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1555.003",
          "technique": "Credentials from Password Stores",
          "tactic": "Credential Access",
          "tacticKey": "TA0006"
        }
      ],
      "useCases": [
        "Compromised Credentials"
      ],
      "value": "contains(toLower(file_name), 'login data')",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "file-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "file-critical-file-group"
    }
  ]
}