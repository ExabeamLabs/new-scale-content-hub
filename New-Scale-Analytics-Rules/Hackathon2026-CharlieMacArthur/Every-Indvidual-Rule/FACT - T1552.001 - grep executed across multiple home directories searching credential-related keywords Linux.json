{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1552-001-Bulk-grep-for-Credentials-42",
      "name": "T1552.001 — Bulk grep for Credentials (Fact #42)",
      "description": "Bulk grep for Credentials. Trigger: grep executed across multiple home directories searching credential-related keywords",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Unix"
          ]
        }
      ],
      "requiredFields": [
        "process_path"
      ],
      "detectionReason": "grep executed on {host}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1552.001",
          "technique": "Unsecured Credentials",
          "tactic": "Credential Access",
          "tacticKey": "TA0006"
        }
      ],
      "useCases": [
        "Privilege Escalation"
      ],
      "value": "toLower(process_path) = '/usr/bin/grep'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-process-execution-group"
    }
  ]
