      "type": "profiledFeature",
      "mitre": [
        {
          "techniqueKey": "T1027.002",
          "technique": "Obfuscated Files or Information",
          "tactic": "Defense Evasion",
          "tacticKey": "TA0005"
        }
      ],
      "useCases": [
        "Evasion"
      ],
      "featureValue": "process_path",
      "scopeValue": "EntityId('type: Device && direction: Source')",
      "trainOnCondition": "user_id = '0' && contains(toLower(process_path), 'curl')",
      "actOnCondition": "user_id = '0' && contains(toLower(process_path), 'curl')",
      "anomalyThreshold": "21 days",
      "checkScopeMaturity": false,
      "checkFeatureMaturity": false,
      "scoreUnless": [],
      "suppressThreshold": "",
