{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1003-001-LSASS-Dump-via-rundll32-comsvcs-3",
      "name": "T1003.001 — LSASS Dump via rundll32 comsvcs (Fact #3)",
      "description": "LSASS Dump via rundll32 comsvcs. Trigger: New file created matching lsass*.dmp in a non-system directory",
      "applicableEvents": [
        {
          "activity_type": [
            "file-write"
          ],
          "platform": [
            "Windows"
          ],
          "event_code": [
            "11"
          ]
        }
      ],
      "requiredFields": [
        "event_code",
        "file_name",
        "file_dir"
      ],
      "detectionReason": "Dump file '{file_name}' created in {file_dir} by {process_name}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1003.001",
          "technique": "OS Credential Dumping",
          "tactic": "Credential Access",
          "tacticKey": "TA0006"
        }
      ],
      "useCases": [
        "Compromised Credentials"
      ],
      "value": "endsWith(toLower(file_name), '.dmp') && toLower(file_dir) != 'c:\\\\windows\\\\temp\\\\'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "file-write-activity",
      "severity": "High",
      "testMode": false,
      "ruleGroupId": "filew-file-process-group"
    }
  ]
}