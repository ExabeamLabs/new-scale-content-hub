{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1046-nmap-Sweep-from-Compromised-Web-Server-35",
      "name": "T1046 — nmap Sweep from Compromised Web Server (Fact #35)",
      "description": "nmap Sweep from Compromised Web Server. Trigger: netcat executed by the same service account shortly after a port-scanning utility",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Unix"
          ]
        }
      ],
      "requiredFields": [
        "process_path",
        "user_id"
      ],
      "detectionReason": "netcat executed on {host} by uid {user_id}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1046",
          "technique": "Network Service Discovery",
          "tactic": "Discovery",
          "tacticKey": "TA0007"
        }
      ],
      "useCases": [
        "Compromised Credentials"
      ],
      "value": "toLower(process_path) = '/usr/bin/nc' && user_id = '33'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-process-execution-group"
    }
  ]
}