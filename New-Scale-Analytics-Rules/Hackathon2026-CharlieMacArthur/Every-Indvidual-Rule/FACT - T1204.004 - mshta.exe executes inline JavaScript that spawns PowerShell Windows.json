{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1204-004-ClickFix-Paste-and-Run-17",
      "name": "T1204.004 — ClickFix Paste-and-Run (Fact #17)",
      "description": "ClickFix Paste-and-Run. Trigger: mshta.exe executes inline JavaScript that spawns PowerShell",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Windows"
          ],
          "event_code": [
            "1"
          ]
        }
      ],
      "requiredFields": [
        "event_code",
        "process_name",
        "process_command_line"
      ],
      "detectionReason": "mshta.exe executed inline JavaScript spawning a shell: {process_command_line}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1204.004",
          "technique": "User Execution",
          "tactic": "Execution",
          "tacticKey": "TA0002"
        }
      ],
      "useCases": [
        "Malware"
      ],
      "value": "toLower(process_name) = 'mshta.exe' && contains(toLower(process_command_line), 'activexobject')",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-html-execution-group"
    }
  ]
}