{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1055-Process-Injection-into-Notepad-9",
      "name": "T1055 — Process Injection into Notepad (Fact #9)",
      "description": "Process Injection into Notepad. Trigger: Process opened with PROCESS_ALL_ACCESS (0x1F3FFF) by a non-system binary",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Windows"
          ],
          "event_code": [
            "10"
          ]
        }
      ],
      "requiredFields": [
        "event_code",
        "process_name",
        "parent_process_name",
        "result"
      ],
      "detectionReason": "'{parent_process_name}' opened {process_name} with GrantedAccess {result} (PROCESS_ALL_ACCESS)",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1055",
          "technique": "Process Injection",
          "tactic": "Defense Evasion",
          "tacticKey": "TA0005"
        }
      ],
      "useCases": [
        "Malware"
      ],
      "value": "toLower(process_name) = 'notepad.exe' && toLower(parent_process_name) = 'update.exe' && result = '0x1F3FFF'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-process-memory-dump-group"
    }
  ]
}