{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1027-002-UPX-Packed-ELF-from-dev-shm-32",
      "name": "T1027.002 — UPX-Packed ELF from /dev/shm (Fact #32)",
      "description": "UPX-Packed ELF from /dev/shm. Trigger: Privileged chmod execution by root immediately after a download utility",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Unix"
          ]
        }
      ],
      "requiredFields": [
        "process_path",
        "user_id"
      ],
      "detectionReason": "Privileged (root) chmod executed on {host}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1027.002",
          "technique": "Obfuscated Files or Information",
          "tactic": "Defense Evasion",
          "tacticKey": "TA0005"
        }
      ],
      "useCases": [
        "Evasion"
      ],
      "value": "toLower(process_path) = '/bin/chmod' && user_id = '0'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-process-execution-group"
    }
  ]
}