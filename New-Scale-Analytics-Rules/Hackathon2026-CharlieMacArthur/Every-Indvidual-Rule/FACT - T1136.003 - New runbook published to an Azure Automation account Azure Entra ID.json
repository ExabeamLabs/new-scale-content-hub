{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1136-003-Malicious-Automation-Runbook-55",
      "name": "T1136.003 — Malicious Automation Runbook (Fact #55)",
      "description": "Malicious Automation Runbook. Trigger: New runbook published to an Azure Automation account",
      "applicableEvents": [
        {
          "activity_type": [
            "app-activity"
          ],
          "category": [
            "Administrative"
          ],
          "platform": [
            "Azure"
          ]
        }
      ],
      "requiredFields": [
        "category",
        "operation"
      ],
      "detectionReason": "New runbook published: {operation}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1136.003",
          "technique": "Create Account",
          "tactic": "Persistence",
          "tacticKey": "TA0003"
        }
      ],
      "useCases": [
        "Account Manipulation"
      ],
      "value": "operation = 'Microsoft.Automation/automationAccounts/runbooks/write'",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "EntityId('type: User && direction: Source')",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "cloud-policy-management-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "cpm-first-resource-group"
    }
  ]
