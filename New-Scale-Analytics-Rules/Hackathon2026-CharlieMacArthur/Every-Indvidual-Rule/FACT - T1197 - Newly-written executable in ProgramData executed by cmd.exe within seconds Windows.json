{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1197-BITS-Job-Abuse-16",
      "name": "T1197 — BITS Job Abuse (Fact #16)",
      "description": "BITS Job Abuse. Trigger: Newly-written executable in ProgramData executed by cmd.exe within seconds",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Windows"
          ],
          "event_code": [
            "1"
          ]
        }
      ],
      "requiredFields": [
        "event_code",
        "process_name",
        "process_command_line"
      ],
      "detectionReason": "cmd.exe executed a file from ProgramData: {process_command_line}",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1197",
          "technique": "BITS Jobs",
          "tactic": "Defense Evasion",
          "tacticKey": "TA0005"
        }
      ],
      "useCases": [
        "Malware"
      ],
      "value": "toLower(process_name) = 'cmd.exe' && contains(toLower(process_command_line), 'programdata')",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "Medium",
      "testMode": false,
      "ruleGroupId": "pc-process-execution-group"
    }
  ]
}