{
  "version": "1",
  "ruleDefinitions": [
    {
      "templateId": "Fact-T1555-003-Browser-Credential-Theft-Infostealer-24",
      "name": "T1555.003 — Browser Credential Theft (Infostealer) (Fact #24)",
      "description": "Browser Credential Theft (Infostealer). Trigger: Process opens lsass.exe with PROCESS_VM_READ from a masquerading svchost-named binary in AppData\\Temp",
      "applicableEvents": [
        {
          "activity_type": [
            "process-create"
          ],
          "platform": [
            "Windows"
          ],
          "event_code": [
            "10"
          ]
        }
      ],
      "requiredFields": [
        "event_code",
        "result",
        "process_name",
        "parent_process_dir"
      ],
      "detectionReason": "'{parent_process_name}' from AppData\\Temp opened lsass.exe with GrantedAccess {result} (PROCESS_VM_READ)",
      "type": "factFeature",
      "mitre": [
        {
          "techniqueKey": "T1555.003",
          "technique": "Credentials from Password Stores",
          "tactic": "Credential Access",
          "tacticKey": "TA0006"
        }
      ],
      "useCases": [
        "Compromised Credentials"
      ],
      "value": "result = '0x1010' && toLower(process_name) = 'lsass.exe' && contains(toLower(parent_process_dir), 'appdata\\\\local\\\\temp')",
      "actOnCondition": "true",
      "suppressThreshold": "10 minutes",
      "suppressScope": "JoinIfExists(EntityId('type: User && direction: Source'), EntityId('type: Device && direction: Source'))",
      "trainOnCondition": "true",
      "scoreUnless": [],
      "familyId": "process-creation-activity",
      "severity": "High",
      "testMode": false,
      "ruleGroupId": "pc-lsass-memory-dump"
    }
  ]
}